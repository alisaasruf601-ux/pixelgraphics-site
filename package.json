{
  "name": "pixel-graphics-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ -n \"$TINA_TOKEN\" ] && [ -n \"$NEXT_PUBLIC_TINA_CLIENT_ID\" ]; then tinacms build && next build; else next build; fi",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:cms": "tinacms dev -c \"next dev\""
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tinacms/cli": "4.0.3",
    "framer-motion": "^11.18.2",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tinacms": "3.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
